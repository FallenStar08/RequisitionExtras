Configs: {
	ModSettings: {
		DisplayName: Requisition Extras Settings

		DebugText: {
			Label: Debug Text
			Tooltip: Enables debug text for troubleshooting purposes
		}

		EnableRightClickDeposit: {
			Label: Enable Right-Click Deposit
			Tooltip: Allows depositing all inventory items into the terminal by right-clicking with the remote in hand
		}

		EnableChestUnlockMessages: {
			Label: Enable Chest Unlock Messages
			Tooltip: Displays a message when a chest is unlocked via a key present in a network
		}
	}
}

EasyLoca: {
	PopulateCraftingCoreButtonText: Populate
	PopulateCraftingCoreButtonTooltip:
		'''
		Automatically fetch all stations that would fullfil new conditions for crafting
		If a station would fullfil a role already populated (and provide a new one), it will replace it.
		'''
	SellReportHeader: Sell Report :
	SelectModeHeader: Select Duplicate Selling Mode:
	ModeKeepBest: Keep Most Expensive
	ModeKeepBestTooltip:
		'''
		Compares duplicate items by monetary value.
		Keeps the single best version and sells all lower-tier duplicates.
		'''
	ModeKeepFirst: Keep First Found
	ModeKeepFirstTooltip:
		'''
		Keeps the very first instance found in your storage system
		and sells every other duplicate regardless of prefix.
		'''
	ModeExactMatches: Keep One Of Each Prefix
	ModeExactMatchesTooltip:
		'''
		Only sells items if they match both Item ID AND Prefix.
		(It'll keep one of each item with a unique combination of Item ID and Prefix).
		'''
	SellActionButton: Sell Duplicate Items
	ReportNoItems: No items sold yet.
	ReportNoDuplicates: No duplicates found to sell.
	ReportSummary: Sold {0} items for {1}
	ExtrasTabName: Extras
	ChestUnlockMessage: Unlocked chest {0}{1} using {2}{3} from remote networks
	ChestUnlockFailedMessage: Failed to unlock chest {0}{1} using {2}{3} from remote networks
}
